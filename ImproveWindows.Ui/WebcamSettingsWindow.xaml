<Window x:Class="ImproveWindows.Ui.WebcamSettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Webcam settings" Width="1000" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <Label Name="CameraName" FontWeight="Bold" DockPanel.Dock="Top"></Label>
        <!-- 16:9 like the 1080p stream -->
        <Grid Name="PreviewBox" DockPanel.Dock="Top" Width="960" Height="540" Margin="0,0,0,10" Background="Black">
            <!-- Mirrored, like looking into a mirror -->
            <Image Name="Preview" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="-1"/>
                </Image.RenderTransform>
            </Image>
            <TextBlock Name="PreviewStatus" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap">Starting preview…</TextBlock>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Click="DefaultsBtnClick" Padding="10,3" Margin="5,0">Defaults</Button>
            <Button Click="SaveBtnClick" Padding="10,3" Margin="5,0" IsDefault="True">Save</Button>
            <Button Click="CancelBtnClick" Padding="10,3" Margin="5,0" IsCancel="True">Cancel</Button>
        </StackPanel>
        <Grid Name="ControlsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
        </Grid>
    </DockPanel>
</Window>
